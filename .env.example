# Sanasaaga environment configuration.
# Copy this file to ".env" (which is gitignored) and fill in real values,
# or export the variables in your shell before running the stack.

# Server-side secret mixed into the daily-challenge SHA-256 seed
# (seed = secret + ":" + Helsinki_date). It is NEVER sent to the browser, and
# without it the daily word cannot be reconstructed even from the dictionary.
# Use a long random string. The backend refuses to start a daily game if this
# is empty/unset.
DAILY_WORD_SECRET=

# Used by compose.prod.yaml to select the GHCR image owner.
# GHCR_OWNER=your-github-username
